---
interface Props {
    name: string;
}

const { name } = Astro.props;
---

<style>
    .project-meta-stat {
        display: flex;
        flex-direction: column;
        align-items: flex-start;

        @media (--bp-600) {
            flex-direction: row;
        }
    }

    .stat-name {
        padding-block: 8px;
        padding-inline: 12px;
        color: var(--color-brand-white);
        font-weight: 600;
        font-size: var(--font-size-400);
        background-color: var(--color-brand-black);
    }

    .stat-value {
        padding-block: 8px;
        padding-inline: 12px;
        color: var(--color-brand-black);
        font-weight: 400;
        font-size: var(--font-size-400);
        background-color: var(--color-brand-grey-dark);
    }
</style>

<dl class="project-meta-stat">
    <dt class="stat-name">{name}</dt>
    <dd class="stat-value"><slot /></dd>
</dl>
