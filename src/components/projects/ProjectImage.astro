---
import { Image } from 'astro:assets';

import MediaFrame from '@snowbeat/components/shared/mediaFrames/MediaFrame.astro';

interface Props {
    src: ImageMetadata;
    type?: ImageType;
    alt?: string;
    caption?: string;
}

const { src, type = 'raw', alt = '', caption } = Astro.props;
---

<style>
    .project-image {
        position: relative;
        display: flex;
        justify-content: center;
    }

    .image {
        width: 100%;
        height: auto;
        border-radius: 8px;
        overflow: clip;
    }

    .crop-image {
        border-radius: 8px 8px 0 0;
    }
</style>

<div class="project-image">
    <MediaFrame type={type} caption={caption}>
        <Image
            src={src}
            alt={alt}
            class={`image ${type === 'screen-crop' ? ' crop-image' : ''}`}
        />
    </MediaFrame>
</div>
