---
import ScreenCropImage from '@snowbeat/components/shared/imageFrames/ScreenCropImage.astro';
import TabletImage from '../shared/imageFrames/TabletImage.astro';
import RawImage from '../shared/imageFrames/RawImage.astro';

interface Props {
    image: ImageMetadata;
    type?: 'screen-crop' | 'raw' | 'tablet' | 'phone';
    alt?: string;
    caption?: string;
}

const { image, type = 'raw', alt = '', caption } = Astro.props;
---

<style>
    .project-image {
        position: relative;
        display: block;
    }
</style>

<figure class="project-image section-content">
    {type === 'raw' && <RawImage src={image} alt="" caption={caption} />}
    {
        type === 'screen-crop' && (
            <ScreenCropImage src={image} caption={caption} alt={alt} />
        )
    }
    {type === 'tablet' && <TabletImage src={image} caption={caption} />}
</figure>
