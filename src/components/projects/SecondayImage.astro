---
import { Image } from 'astro:assets';

import ScreenCropImage from '@snowbeat/components/shared/imageFrames/ScreenCropImage.astro';

interface Props {
    image: ImageMetadata;
    type?: 'screen-crop' | 'unframed';
}

const { image, type = 'unframed' } = Astro.props;
---

<style>
    .secondary-image {
        padding-bottom: 40px;
    }

    .image {
        width: 100%;
        height: auto;
    }
</style>
<figure class="secondary-image section-content">
    {type === 'unframed' && <Image src={image} alt="" class="image" />}
    {type === 'screen-crop' && <ScreenCropImage src={image} />}
</figure>
