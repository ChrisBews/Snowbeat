---
import VideoPlayer from '@snowbeat/components/shared/video/VideoPlayer.astro';

type Props = VideoPlayerProps;
---

<style>
    .project-video {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 8px;
        overflow: clip;
        touch-action: manipulation;
    }
</style>

<div class="project-video">
    <VideoPlayer {...Astro.props} />
</div>
