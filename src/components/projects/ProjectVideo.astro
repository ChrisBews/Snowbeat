---
import VideoControls from '@snowbeat/components/shared/video/VideoControls.astro';
import HighlightText from '@snowbeat/components/shared/HighlightText.astro';
import MediaFrame from '@snowbeat/components/shared/mediaFrames/MediaFrame.astro';

interface Props {
    src: string;
    type?:
        'screen-crop' | 'raw' | 'tablet' | 'phone-portrait' | 'phone-landscape';
    caption?: string;
    isMuted?: boolean;
    isLooping?: boolean;
    isAutoPlaying?: boolean;
    controlsType?: VideoControlsType;
    poster?: ImageMetadata;
    shouldPreload?: boolean;
    width?: number;
    height?: number;
}

const {
    src,
    type = 'raw',
    caption,
    isMuted,
    isLooping,
    isAutoPlaying,
    controlsType = 'none',
    poster,
    shouldPreload,
    width,
    height,
} = Astro.props;

const videoPreloadValue =
    isAutoPlaying || shouldPreload ? 'auto' : poster ? 'none' : 'metadata';
---

<style>
    .project-video {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 8px;
        overflow: clip;
        touch-action: manipulation;
    }

    .project-video video-player {
        display: block;
        width: 100%;
    }

    .project-video video {
        width: 100%;
        height: auto;
    }

    .crop-image {
        border-radius: 8px 8px 0 0;
    }

    .error-message {
        position: absolute;
        inset: 0;
        display: none;
    }

    .has-error .error-message {
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="project-video">
    <video-player data-controls-type={controlsType}>
        <MediaFrame
            type={type}
            caption={controlsType === 'none' ? caption : undefined}
        >
            <video
                src={src}
                loop={isLooping}
                muted={isMuted || isAutoPlaying}
                autoplay={isAutoPlaying}
                playsinline
                class={`image ${type === 'screen-crop' ? ' crop-image' : ''}`}
                poster={poster?.src}
                preload={videoPreloadValue}
                width={width}
                height={height}></video>
        </MediaFrame>
        {
            ['full', 'simple'].includes(controlsType) && (
                <VideoControls
                    controlsType={controlsType}
                    isInitiallyMuted={isMuted || isAutoPlaying}
                    isAutoPlaying={isAutoPlaying}
                    caption={caption}
                />
            )
        }
        <div class="error-message">
            <HighlightText>Error loading video</HighlightText>
        </div>
    </video-player>
</div>

<script>
    import { VideoPlayerEvent } from '@snowbeat/constants';

    class VideoPlayer extends HTMLElement {
        private video: HTMLVideoElement | null = null;
        private playerControls: VideoControlsElement | null = null;
        private isPlaying: boolean = false;
        private isMuted: boolean = false;
        private hasStarted: boolean = false;
        private isIOSFullScreen: boolean = false;

        connectedCallback() {
            this.video = this.querySelector('video');
            this.isMuted = Boolean(this.video?.muted);
            this.playerControls = this.querySelector('[data-video-controls]');

            if (this.video?.autoplay) {
                this.hasStarted = true;
                this.isPlaying = true;
            }

            this.prepareListeners();
        }

        private prepareListeners = () => {
            this.video?.addEventListener('waiting', this.handleVideoWaiting);
            this.video?.addEventListener('playing', this.handleVideoPlaying);
            this.video?.addEventListener('error', this.handleVideoError);
            this.video?.addEventListener('ended', this.handleVideoEnded);
            this.video?.addEventListener('timeupdate', this.handleTimeUpdate);

            this.playerControls?.addEventListener(
                VideoPlayerEvent.PROGRESS_CHANGE,
                this.handleProgressBarMove
            );
            this.playerControls?.addEventListener(
                VideoPlayerEvent.PLAY_PRESS,
                this.handlePlayButtonPress
            );
            this.playerControls?.addEventListener(
                VideoPlayerEvent.VOLUME_PRESS,
                this.handleVolumePress
            );
            this.playerControls?.addEventListener(
                VideoPlayerEvent.FULL_SCREEN_PRESSS,
                this.handleFullScreenPress
            );
            this.addEventListener('mouseleave', this.handleMouseLeave);
            this.addEventListener(
                'fullscreenchange',
                this.handleFullScreenChange
            );
        };

        private markVideoStarted = () => {
            if (!this.hasStarted) {
                this.hasStarted = true;
                this.playerControls?.setHasStarted(true);
            }
        };

        private markVideoNotStarted = () => {
            if (this.hasStarted) {
                this.hasStarted = false;
                this.playerControls?.setHasStarted(false);
            }
        };

        private handleVideoWaiting = () => {
            this.playerControls?.setLoading(true);
        };

        private handleVideoPlaying = () => {
            this.playerControls?.setLoading(false);
        };

        private handleVideoError = () => {
            this.playerControls?.setLoading(false);
            this.playerControls?.setHasError();
            this.classList.add('has-error');
        };

        private handleMouseLeave = () => {
            if (this.isPlaying) {
                this.playerControls?.hide();
            }
        };

        private handleProgressBarMove = (e: CustomEvent) => {
            if (!this.video || !Number.isFinite(this.video.duration)) return;

            const seekTime =
                (e.detail.percentage / 100) * (this.video?.duration || 0);
            this.video.currentTime = seekTime;
        };

        private handleTimeUpdate = () => {
            this.playerControls?.updateProgress(
                this.video?.currentTime || 0,
                this.video?.duration || 0
            );
        };

        private handleFullScreenChange = () => {
            this.isIOSFullScreen = false;
            this.playerControls?.setFullScreenActive(
                Boolean(document.fullscreenElement)
            );
        };

        private handleFullScreenPress = () => {
            if (document.fullscreenElement || this.isIOSFullScreen) {
                this.isIOSFullScreen = false;
                document.exitFullscreen().catch(() => {
                    // Ignore if user somehow enters during full screen exit
                });
            } else if (this.requestFullscreen) {
                this.requestFullscreen().catch(() => {
                    // Ignore if user exits during the full screen request
                });
            } else {
                this.isIOSFullScreen = true;
                // iOS safari still needs this
                this.video?.webkitEnterFullScreen?.();
            }
        };

        private handleVolumePress = () => {
            this.isMuted = !this.isMuted;
            this.playerControls?.setMuted(this.isMuted);
            if (this.video) this.video.muted = this.isMuted;
        };

        private handlePlayButtonPress = () => {
            if (!this.isPlaying) {
                this.markVideoStarted();
                this.isPlaying = true;
                this.playerControls?.setVideoPlaying(true);
                this.video?.play()?.catch(() => {
                    this.isPlaying = false;
                    this.playerControls?.setVideoPlaying(false);
                });
            } else {
                this.isPlaying = false;
                this.playerControls?.setVideoPlaying(false);
                this.video?.pause();
                this.playerControls?.show();
            }
        };

        private handleVideoEnded = () => {
            this.playerControls?.hide();
            this.playerControls?.setVideoPlaying(false);
            this.isPlaying = false;
            this.playerControls?.show(true);
            this.markVideoNotStarted();
        };
    }

    customElements.define('video-player', VideoPlayer);
</script>
