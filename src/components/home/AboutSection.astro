---
import { Image } from 'astro:assets';

import { GITHUB_URL, LINKEDIN_URL } from '@snowbeat/constants';

import SectionTitle from '../shared/SectionTitle.astro';
import IconButton from '../shared/IconButton.astro';

import SnowbeatIcon from '@snowbeat/assets/images/logo-icon.svg';
---

<style>
    section {
        position: relative;
        padding-bottom: 60px;
        text-align: center;
        background-color: var(--color-brand-yellow);
        overflow: clip;
    }

    @keyframes about-logo-scroll {
        from {
            translate: -50% -5%;
        }

        to {
            translate: -50% 5%;
        }
    }

    .background-icon {
        position: absolute;
        top: 2.5%;
        left: calc(50% + min(10svw, 150px));
        z-index: var(--z-base);
        translate: -50% -10%;
        width: clamp(700px, 100vw, 2000px);
        height: auto;
        animation: about-logo-scroll linear;
        animation-timeline: view();

        @media (--bp-900) {
            width: clamp(1300px, 190svw, 2000px);
        }

        @media (prefers-reduced-motion: reduce) {
            animation: none;
        }
    }

    .content-wrapper {
        position: relative;
        z-index: var(--z-above-base);
    }

    .social-links {
        display: flex;
        flex-flow: row wrap;
        justify-content: center;
        gap: 20px;
        list-style: none;
        padding-top: 40px;

        @media (--bp-600) {
            gap: 32px;
            padding-top: 60px;
        }
    }
</style>

<section id="about">
    <Image
        src={SnowbeatIcon}
        alt=""
        width="2000"
        class="background-icon"
        aria-hidden
    />

    <div class="section-content-reduced content-wrapper">
        <SectionTitle>About</SectionTitle>
        <p>
            I am a developer based in London, with 20 years of experience split
            between design agencies and a hardware/software startup. I began as
            a designer, then moved into frontend web development (with Flash,
            hand drawn animation, 3D modelling, and information architecture
            mixed in), then moved into React Native mobile app development. I
            also have experience managing other developers and making wider
            architectural decisions. I generally try to cover any gaps that
            arise to help the wider team achieve their goals.
        </p>
        <h3 class="visually-hidden">Social links</h3>
        <ul class="social-links">
            <li>
                <IconButton href={LINKEDIN_URL} icon="linkedin"
                    >Find me on LinkedIn</IconButton
                >
            </li>
            <li>
                <IconButton href={GITHUB_URL} icon="github"
                    >Find me on Github</IconButton
                >
            </li>
        </ul>
    </div>
</section>
