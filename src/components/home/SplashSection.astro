---
import { Image } from 'astro:assets';

import SnowbeatLogo from '@snowbeat/assets/images/logo.svg';
import SnowbeatIcon from '@snowbeat/assets/images/logo-icon.svg';
---

<style>
    .wrapper {
        position: relative;
        width: 100%;
        color: var(--color-brand-black);
        background-color: var(--color-brand-yellow);
        overflow: clip;
    }

    .content-wrapper {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 80svh;
        max-height: 634px;
        min-height: 360px;
        padding-bottom: 10px;
        padding-inline: 40px;
    }

    .logo {
        width: 100%;
        max-width: 494px;
        height: auto;
    }

    @keyframes logo-scroll {
        from {
            translate: -50% -55%;
        }

        to {
            translate: -50% -45%;
        }
    }

    h2 {
        padding-top: 1rem;
        font-family: var(--font-worksans);
        font-size: clamp(1rem, 4.3vw, 1.5625rem);
        text-align: center;
        text-wrap: pretty;
    }

    .background-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 1;
        width: clamp(400px, 140svw, 1300px);
        height: auto;
        translate: -50% -60%;
        animation: logo-scroll;
        animation-timeline: view();
    }

    @media (--bp-600) {
        h2 {
            padding-top: 1.25rem;
        }
    }
</style>

<section class="wrapper" data-splash-section>
    <Image
        src={SnowbeatIcon}
        alt=""
        width="1200"
        class="background-icon"
        aria-hidden
        loading="eager"
        decoding="sync"
    />
    <div class="section-content content-wrapper">
        <h1>
            <span class="visually-hidden">Snowbeat</span>
            <SnowbeatLogo aria-hidden="true" class="logo" />
        </h1>
        <h2>The home of developer Christopher Bews</h2>
    </div>
</section>
