---
import { getCollection } from 'astro:content';

import SectionTitle from '../shared/SectionTitle.astro';
import TimelineEvent from './TimelineEvent.astro';

const timelineEvents = (await getCollection('timeline')).sort(
    (a, b) => b.data.startYear - a.data.startYear
);
---

<style>
    section {
        padding-bottom: 80px;
        background-color: var(--color-brand-grey-mid);
    }

    .event-list {
        display: flex;
        flex-direction: column;
        gap: 60px;
        list-style: none;

        @media (--bp-800) {
            gap: 80px;
        }
    }
</style>

<section id="timeline">
    <SectionTitle>Timeline</SectionTitle>
    <ol class="section-content-reduced event-list">
        {
            timelineEvents.map((timelineEvent) => (
                <li>
                    <TimelineEvent
                        companyLogo={timelineEvent.data.companyLogo}
                        companyName={timelineEvent.data.companyName}
                        startYear={timelineEvent.data.startYear}
                        endYear={timelineEvent.data.endYear}
                        roles={timelineEvent.data.roles}
                    />
                </li>
            ))
        }
    </ol>
</section>
