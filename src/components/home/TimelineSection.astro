---
import SectionTitle from '../shared/SectionTitle.astro';
import TimelineEvent from './TimelineEvent.astro';

import NationLogo from '@snowbeat/assets/images/timeline/company-logo-nation.svg';
import DigitLogo from '@snowbeat/assets/images/timeline/company-logo-digit.svg';
import RoliLogo from '@snowbeat/assets/images/timeline/company-logo-roli.svg';

const timelineData: TimelineEventData[] = [
    {
        companyLogo: RoliLogo,
        companyName: 'Luminary ROLI',
        startYear: 2016,
        endYear: 2026,
        roles: [
            {
                position: 'Lead Software Engineer',
                startYear: 2020,
                endYear: 2026,
            },
            {
                position: 'Senior Web Developer',
                startYear: 2016,
                endYear: 2020,
            },
        ],
    },
    {
        companyLogo: NationLogo,
        companyName: 'Nation',
        startYear: 2009,
        endYear: 2016,
        roles: [
            {
                position: 'Lead developer',
                startYear: 2009,
                endYear: 2016,
            },
        ],
    },
    {
        companyLogo: DigitLogo,
        companyName: 'Digit',
        startYear: 2006,
        endYear: 2009,
        roles: [
            {
                position: 'Interaction Designer',
                startYear: 2007,
                endYear: 2009,
            },
            {
                position: 'Junior Designer',
                startYear: 2006,
                endYear: 2007,
            },
        ],
    },
];
---

<style>
    section {
        padding-bottom: 80px;
        background-color: var(--color-brand-grey-mid);
    }

    .event-list {
        display: flex;
        flex-direction: column;
        gap: 60px;
        list-style: none;

        @media (--bp-500) {
            gap: 60px;
        }

        @media (--bp-800) {
            gap: 80px;
        }
    }
</style>

<section>
    <SectionTitle>Timeline</SectionTitle>
    <ol class="section-content-reduced event-list">
        {
            timelineData.map((data) => (
                <li>
                    <TimelineEvent
                        companyLogo={data.companyLogo}
                        companyName={data.companyName}
                        startYear={data.startYear}
                        endYear={data.endYear}
                        roles={data.roles}
                    />
                </li>
            ))
        }
    </ol>
</section>
