---
interface Props extends TimelineEventData {}

const { companyLogo, companyName, startYear, endYear, roles } = Astro.props;
---

<style>
    .timeline-event {
        display: flex;
        flex-direction: column;
        gap: 20px;

        @media (--bp-500) {
            flex-direction: row;
        }
    }

    .event-details {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .company-logo {
        width: 100%;
        border-radius: 8px;
        overflow: hidden;

        @media (--bp-500) {
            width: 130px;
        }

        @media (--bp-600) {
            width: 170px;
        }
    }

    .company-logo img {
        width: 100%;
        height: auto;
        aspect-ratio: 1.25;
        object-fit: cover;

        @media (--bp-500) {
            aspect-ratio: 1;
        }
    }

    .company-name {
        font-size: var(--font-size-600);
    }

    .timespan {
        padding: 8px 16px;
        font-family: var(--font-geist);
        font-size: var(--font-size-450);
        font-weight: 700;
        background-color: var(--color-brand-yellow);
    }

    .role-list {
        list-style: none;
        padding-top: 2px;
    }

    .role {
        font-size: var(--font-size-400);
        font-weight: 700;
    }

    dl {
        display: inline-block;
    }
</style>
<div class="timeline-event">
    <div class="company-logo">
        <img
            src={companyLogo.src}
            alt={`{companyName} logo`}
            width="170"
            height="170"
        />
    </div>
    <div class="event-details">
        <dl>
            <dt class="visually-hidden">Timespan</dt>
            <dd class="timespan">
                <time datetime={startYear.toString()}>{startYear}</time>-<time
                    datetime={endYear.toString()}>{endYear}</time
                >
            </dd>
        </dl>
        <h3 class="company-name">{companyName}</h3>
        <dl>
            <dt class="visually-hidden">Roles</dt>
            <dd>
                <ol class="role-list">
                    {
                        roles.map((data) => (
                            <li class="role">
                                {data.position} (
                                <time datetime={startYear.toString()}>
                                    {data.startYear}
                                </time>
                                -
                                <time datetime={data.endYear.toString()}>
                                    {data.endYear})
                                </time>
                            </li>
                        ))
                    }
                </ol>
            </dd>
        </dl>
    </div>
</div>
