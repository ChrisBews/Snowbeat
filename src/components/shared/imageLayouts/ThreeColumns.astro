<style>
    .three-columns {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
        gap: inherit;

        @media (--bp-600) {
            grid-template-columns: repeat(2, 1fr);

            .project-image:nth-child(3n) {
                grid-column: 1 /3;
            }
        }

        @media (--bp-900) {
            grid-template-columns: repeat(3, 1fr);

            .project-image:nth-child(3n) {
                grid-column: initial;
            }
        }
    }
</style>

<div class="three-columns section-content">
    <slot />
</div>
