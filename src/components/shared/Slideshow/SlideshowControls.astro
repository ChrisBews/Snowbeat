---
import SlideshowCaptions from './SlideshowCaptions.astro';
import SlideshowPips from './SlideshowPips.astro';

interface Props {
    totalSlides: number;
    hasPips?: boolean;
    captions?: (string | undefined)[];
}

const { totalSlides, hasPips, captions = [] } = Astro.props;
---

<style>
    @keyframes slideshow-press-anim {
        0% {
            scale: 1;
        }

        50% {
            scale: 0.97;
        }

        100% {
            scale: 1;
        }
    }

    .slideshow-controls {
        position: absolute;
        inset: 0;
        z-index: var(--z-controls);
    }

    .overlay-button {
        position: absolute;
        top: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 50%;
        padding-inline: 20px;
        border: 0;
        outline: 0;
        cursor: pointer;
        background: transparent;
        -webkit-tap-highlight-color: transparent;

        @media (--bp-800) {
            padding-inline: 40px;
        }

        &.previous {
            left: 0;
            align-items: flex-start;
        }

        &.next {
            right: 0;
            align-items: flex-end;
        }

        .icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 100px;
            border-radius: 8px;
            background-color: var(--color-brand-yellow);
            transition:
                background-color 0.15s var(--anim-easing-quad-inout),
                scale 0.15s var(--anim-easing-quad-inout);

            @media (--bp-600) {
                width: 72px;
                height: 120px;
                border-radius: 12px;
            }

            &::after {
                content: '';
                display: block;
                width: 20px;
                height: 21px;
                background-color: var(--color-brand-black);

                @media (--bp-600) {
                    width: 29px;
                    height: 31px;
                }
            }
        }

        &.pressed .icon {
            animation: slideshow-press-anim 0.2s var(--anim-easing-quad-inout);
        }

        .icon::after {
            clip-path: polygon(
                0 37%,
                38% 37%,
                38% 8%,
                100% 50%,
                38% 92%,
                38% 63%,
                0 63%
            );
        }

        &.previous .icon::after {
            rotate: 180deg;
        }

        &:hover .icon {
            scale: 1.05;
            background-color: var(--color-brand-yellow-dark);
        }
    }

    .bottom-nav {
        position: absolute;
        bottom: 24px;
        left: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
</style>

<slideshow-controls class="slideshow-controls" data-slideshow-controls>
    <button class="overlay-button previous"
        ><span class="icon"
            ><span class="visually-hidden">Previous slide</span></span
        ></button
    >
    <button class="overlay-button next"
        ><span class="icon">
            <span class="visually-hidden">Next slide</span></span
        ></button
    >
    <div class="bottom-nav">
        {captions.length > 0 && <SlideshowCaptions captions={captions} />}
        {hasPips && <SlideshowPips totalSlides={totalSlides} />}
    </div>
</slideshow-controls>

<script>
    import { SlideshowEvent } from '@snowbeat/constants';

    class SlideshowControls
        extends HTMLElement
        implements SlideshowControlsElement
    {
        private nextButton: HTMLButtonElement | null = null;
        private previousButton: HTMLButtonElement | null = null;
        private pips: SlideshowPipsElement | null = null;
        private captions: SlideshowCaptionsElement | null = null;

        connectedCallback() {
            this.nextButton = this.querySelector('.next');
            this.previousButton = this.querySelector('.previous');
            this.pips = this.querySelector('[data-slideshow-pips]');
            this.captions = this.querySelector('[data-slideshow-captions]');

            this.prepareListeners();
        }

        private prepareListeners = () => {
            this.nextButton?.addEventListener('click', this.handleNextPress);
            this.previousButton?.addEventListener(
                'click',
                this.handlePreviousPress
            );
        };

        private handleNextPress = () => {
            this.nextButton?.classList.remove('pressed');
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    this.nextButton?.classList.add('pressed');
                });
            });
            this.dispatchEvent(new CustomEvent(SlideshowEvent.NEXT_PRESS));
        };

        private handlePreviousPress = () => {
            this.previousButton?.classList.remove('pressed');
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    this.previousButton?.classList.add('pressed');
                });
            });
            this.dispatchEvent(new CustomEvent(SlideshowEvent.PREVIOUS_PRESS));
        };

        public setActiveSlide = (slideIndex: number) => {
            this.pips?.setActiveSlide(slideIndex);
            this.captions?.setActiveSlide(slideIndex);
        };
    }

    customElements.define('slideshow-controls', SlideshowControls);
</script>
