---
import { Image } from 'astro:assets';

import MediaFrame from '@snowbeat/components/shared/mediaFrames/MediaFrame.astro';
import SlideshowControls from './SlideshowControls.astro';

interface SlideItem {
    src: ImageMetadata;
    type?: ImageType;
    alt?: string;
    caption?: string;
}

interface Props {
    data: SlideItem[];
    hasPips?: boolean;
}

const { data = [], hasPips } = Astro.props;

const captions: (string | undefined)[] = data.map(
    (slideItem) => slideItem.caption
);
---

<style>
    .slideshow {
        position: relative;
        width: 100%;
    }

    .slides-wrapper {
        position: relative;
        display: grid;
        width: 100%;
        overflow: hidden;
    }

    .slide {
        position: relative;
        grid-area: 1/1;
        display: flex;
        width: 100%;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s var(--anim-easing-quad-inout);

        @media (prefers-reduced-motion: reduce) {
            transition: none;
        }

        img {
            width: 100%;
            height: auto;
        }

        &.is-current {
            opacity: 1;
            z-index: 1;
            pointer-events: auto;
        }

        /* Starting state held before animating a slide in */
        &.is-entering {
            opacity: 0;
            z-index: 2;
        }

        &.is-entering.is-visible {
            opacity: 1;
        }
    }
</style>

<section>
    <image-slideshow class="slideshow">
        <div class="slides-wrapper">
            {
                data.map((slideData, i) => (
                    <article
                        class={`slide ${i === 0 ? 'is-current' : ''}`}
                        data-slide
                        data-caption={slideData.caption}
                    >
                        <MediaFrame type={slideData.type}>
                            <Image
                                src={slideData.src}
                                alt={slideData.alt ?? ''}
                            />
                        </MediaFrame>
                    </article>
                ))
            }
        </div>
        <SlideshowControls
            totalSlides={data.length}
            hasPips={hasPips}
            captions={captions}
        />
    </image-slideshow>
</section>

<script>
    import { SlideshowEvent } from '@snowbeat/constants';

    class Slideshow extends HTMLElement {
        private slideTransitionDuration = 150;
        private slideshowControls: SlideshowControlsElement | null = null;
        private slides: HTMLElement[] | null = null;
        private activeSlideIndex = 0;
        private totalSlides = 0;
        private isAnimating = false;
        private transitionFallbackTimer: number | undefined;

        connectedCallback() {
            this.slides = Array.from(this.querySelectorAll('[data-slide]'));
            this.totalSlides = this.slides.length;
            this.slideshowControls = this.querySelector(
                '[data-slideshow-controls]'
            ) as SlideshowControlsElement;
            this.updateSlideTransitionDuration();
            this.prepareListeners();
        }

        private updateSlideTransitionDuration = () => {
            const defaultDuration = 150;
            if (!this.slides?.length) {
                this.slideTransitionDuration = defaultDuration;
                return;
            }

            this.slideTransitionDuration =
                parseFloat(
                    getComputedStyle(this.slides[0]).transitionDuration
                ) * 1000 || defaultDuration;
        };

        private prepareListeners = () => {
            if (this.slideshowControls) {
                this.slideshowControls.addEventListener(
                    SlideshowEvent.NEXT_PRESS,
                    this.handleNextPress
                );
                this.slideshowControls.addEventListener(
                    SlideshowEvent.PREVIOUS_PRESS,
                    this.handlePreviousPress
                );

                this.slideshowControls.addEventListener(
                    SlideshowEvent.PIP_PRESS,
                    this.handlePipPress
                );
            }
        };

        private handlePipPress = (event: CustomEvent) => {
            this.showSlide(event.detail.pipIndex);
        };

        private handlePreviousPress = () => {
            const previousSlideIndex =
                (this.activeSlideIndex - 1 + this.totalSlides) %
                this.totalSlides;
            this.showSlide(previousSlideIndex);
        };

        private handleNextPress = () => {
            const nextSlideIndex =
                (this.activeSlideIndex + 1) % (this.totalSlides || 1);
            this.showSlide(nextSlideIndex);
        };

        private cleanupAfterSlideChange = (
            currentSlide: HTMLElement,
            nextSlide: HTMLElement,
            nextSlideIndex: number
        ) => {
            // Already cleaned up
            if (this.activeSlideIndex === nextSlideIndex) return;

            if (this.transitionFallbackTimer) {
                window.clearTimeout(this.transitionFallbackTimer);
            }

            // Next slide is faded in, so we can let the old one fade out back to it's start state now
            currentSlide.classList.remove('is-current');
            nextSlide.classList.remove('is-entering', 'is-visible');

            nextSlide.classList.add('is-current');
            this.activeSlideIndex = nextSlideIndex;
            this.isAnimating = false;
        };

        private showSlide = (slideIndex: number) => {
            if (
                !this.slides?.length ||
                this.isAnimating ||
                slideIndex === this.activeSlideIndex
            )
                return;

            this.isAnimating = true;

            const currentSlide = this.slides[this.activeSlideIndex];
            const nextSlide = this.slides[slideIndex];

            // Set starting opacity to 0 before animating it in
            nextSlide.classList.add('is-entering');

            this.slideshowControls?.setActiveSlide(slideIndex);

            // Wait for repaint
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    // Animate the next slide in now
                    nextSlide.classList.add('is-visible');

                    nextSlide.addEventListener(
                        'transitionend',
                        (event: TransitionEvent) => {
                            if (
                                event.target !== nextSlide ||
                                event.propertyName !== 'opacity'
                            ) {
                                return;
                            }

                            this.cleanupAfterSlideChange(
                                currentSlide,
                                nextSlide,
                                slideIndex
                            );
                        },
                        { once: true }
                    );
                    this.transitionFallbackTimer = window.setTimeout(
                        () =>
                            this.cleanupAfterSlideChange(
                                currentSlide,
                                nextSlide,
                                slideIndex
                            ),
                        this.slideTransitionDuration + 50
                    );
                });
            });
        };
    }

    customElements.define('image-slideshow', Slideshow);
</script>
