<style>
    .overlay-play-button {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        border: 0;
        outline: 0;
        cursor: pointer;
        background: transparent;
    }

    .overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-brand-black-overlay);
        transition:
            opacity 0.15s linear,
            transform 0.15s linear;
    }

    .overlay-play-button.hidden .overlay,
    .overlay-play-button.active .overlay {
        opacity: 0;
        transform: scale(1.125);
    }

    .overlay-play-button:hover .overlay,
    .overlay-play-button.active:hover .overlay {
        opacity: 1;
        transform: scale(1);
    }

    .overlay-play-button.hidden:hover .overlay {
        opacity: 0;
        transform: scale(1.125);
    }

    .play-button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 102px;
        height: 102px;
        border-radius: 12px;
        overflow: hidden;
        background-color: var(--color-brand-yellow);
    }

    .overlay-play-icon {
        width: calc(50px * 0.9);
        height: 50px;
        clip-path: polygon(100% 50%, 0 100%, 0 0);
        transform: translateX(4px);
        background-color: var(--color-brand-black);
    }

    .active .overlay-play-icon {
        display: none;
    }

    .overlay-pause-icon {
        display: none;
        width: 50px;
        height: 50px;
        border-width: 0 20px;
        border-color: var(--color-brand-black);
        border-style: solid;
    }

    .active .overlay-pause-icon {
        display: block;
    }
</style>

<button class="overlay-play-button">
    <div class="overlay">
        <div class="play-button">
            <div class="overlay-play-icon"></div>
            <div class="overlay-pause-icon"></div>
        </div>
    </div>
</button>
