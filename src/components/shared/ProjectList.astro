---
import type { CollectionEntry } from 'astro:content';

import ProjectListItem from './ProjectListItem.astro';

interface Props {
    isFirstItemHighlighted?: boolean;
    projects: CollectionEntry<'projects' | 'extras'>[];
    basePath: string;
}

const { isFirstItemHighlighted, projects, basePath } = Astro.props;

const parsedProjects = isFirstItemHighlighted ? projects.slice(1) : projects;
---

<style>
    .project-list-items {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px 20px;
        width: 100%;
        padding-bottom: 60px;

        @media (--bp-600) {
            grid-template-columns: repeat(2, 1fr);
        }

        @media (--bp-800) {
            gap: 30px 40px;
        }
    }

    .list-below-highlight {
        padding-top: 34px;
    }
</style>

<div>
    {
        isFirstItemHighlighted && (
            <ProjectListItem
                isFeatured
                title={projects[0].data.title}
                image={projects[0].data.primaryImage}
                type={projects[0].data.type}
                slug={`/${basePath}/${projects[0].id}`}
            />
        )
    }
    <div
        class={`project-list-items section-content${isFirstItemHighlighted ? ' list-below-highlight' : ''}`}
    >
        {
            (parsedProjects || []).map((project) => (
                <ProjectListItem
                    title={project.data.title}
                    image={project.data.primaryImage}
                    type={project.data.type}
                    slug={`/${basePath}/${project.id}`}
                />
            ))
        }
    </div>
</div>
