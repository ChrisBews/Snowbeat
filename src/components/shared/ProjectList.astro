---
import type { CollectionEntry } from 'astro:content';

import ProjectListItem from './ProjectListItem.astro';

interface Props {
    projects: CollectionEntry<'projects' | 'extras'>[];
    basePath: string;
}

const { projects, basePath } = Astro.props;

const featuredItemIndex = projects.findIndex(
    (project) => project.data.isFeatured
);
const hasFeaturedProject = featuredItemIndex > -1;
const featuredProject = hasFeaturedProject ? projects[featuredItemIndex] : null;

const parsedProjects = hasFeaturedProject
    ? projects.filter((project) => !project.data.isFeatured)
    : projects;
---

<style>
    .project-list-items {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px 20px;
        width: 100%;
        padding-bottom: 60px;

        @media (--bp-600) {
            grid-template-columns: repeat(2, 1fr);
        }

        @media (--bp-800) {
            gap: 30px 40px;
        }
    }

    .list-below-highlight {
        padding-top: 34px;
    }
</style>

<div>
    {
        !!featuredProject && (
            <ProjectListItem
                isFeatured
                title={featuredProject.data.title}
                image={featuredProject.data.primaryImage}
                type={featuredProject.data.type}
                slug={`/${basePath}/${featuredProject.id}`}
            />
        )
    }
    <div
        class={`project-list-items section-content${hasFeaturedProject ? ' list-below-highlight' : ''}`}
    >
        {
            parsedProjects.map((project) => (
                <ProjectListItem
                    title={project.data.title}
                    image={project.data.primaryImage}
                    type={project.data.type}
                    slug={`/${basePath}/${project.id}`}
                />
            ))
        }
    </div>
</div>
