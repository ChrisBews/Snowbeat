---
import { Image } from 'astro:assets';
import ImageCaption from '@snowbeat/components/shared/ImageCaption.astro';

interface Props {
    slug: string;
    title: string;
    image: ImageMetadata;
    type: string;
    isFeatured?: boolean;
}

const { slug, title, image, type, isFeatured } = Astro.props;
---

<style>
    article.featured {
        max-width: 1180px;
        margin: 0 auto;
    }

    .content-wrapper {
        display: block;
        text-decoration: none;
    }

    h2 {
        padding-bottom: 0.5rem;
        color: var(--color-brand-black);
        font-size: var(--font-size-500);
    }

    .featured h2 {
        padding-bottom: 1.125rem;
        font-size: var(--font-size-600);
    }

    .featured .content-wrapper {
        padding: 16px 20px 20px;
        background-color: #eee;

        @media (--bp-600) {
            margin-inline: 10px;
            border-radius: 12px;
        }

        @media (--bp-800) {
            padding: 30px 40px 40px;
        }
    }

    figure {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
    }

    .main-image {
        width: 100%;
        height: auto;
    }
</style>

<article class={isFeatured ? 'featured' : ''}>
    <a class="content-wrapper" href={slug}>
        <h2>{title}</h2>
        <figure>
            <Image src={image} alt="Tasklane logo" class="main-image" />
            <ImageCaption>{type}</ImageCaption>
        </figure>
    </a>
</article>
