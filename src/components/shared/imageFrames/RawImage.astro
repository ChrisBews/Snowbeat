---
import { Image } from 'astro:assets';
import ImageCaption from '../ImageCaption.astro';

interface Props {
    src: ImageMetadata;
    alt?: string;
    caption?: string;
}

const { src, alt = '', caption } = Astro.props;
---

<style>
    .raw-image {
        position: relative;
    }

    .image {
        width: 100%;
        height: auto;
        border-radius: 8px;
        overflow: hidden;
    }
</style>
<figure class="raw-image">
    <Image src={src} alt={alt} class="image" />
    {!!caption && <ImageCaption>{caption}</ImageCaption>}
</figure>
