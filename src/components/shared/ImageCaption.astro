---
import HighlightText from './HighlightText.astro';
---

<style>
    .image-caption {
        position: absolute;
        bottom: 20px;
        right: 20px;
        left: 20px;
        text-align: right;

        @media (--bp-800) {
            bottom: 32px;
            right: 32px;
            left: 32px;
        }
    }

    .highlight-wrapper {
        text-align: center;
    }
</style>

<figcaption class="image-caption">
    <span class="highlight-wrapper">
        <HighlightText><slot /></HighlightText>
    </span>
</figcaption>
