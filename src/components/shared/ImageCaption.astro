---
import HighlightText from './HighlightText.astro';

interface Props {
    isThumbnail?: boolean;
}

const { isThumbnail } = Astro.props;

const indent = isThumbnail ? 20 : 32;
const smallIndent = isThumbnail ? 16 : 20;
---

<style
    define:vars={{
        indent: `${indent}px`,
        'small-indent': `${smallIndent}px`,
    }}
>
    .image-caption {
        position: absolute;
        bottom: var(--small-indent);
        right: var(--small-indent);
        left: var(--small-indent);
        text-align: right;

        @media (--bp-800) {
            bottom: var(--indent);
            right: var(--indent);
            left: var(--indent);
        }
    }

    .highlight-wrapper {
        text-align: center;
    }
</style>

<figcaption class="image-caption">
    <span class="highlight-wrapper">
        <HighlightText><slot /></HighlightText>
    </span>
</figcaption>
