---
import ImageCaption from '../ImageCaption.astro';

interface Props {
    caption?: string;
}

const { caption } = Astro.props;
---

<style>
    .tablet-image {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
        padding: 24px 22px;
        border-radius: 8px;
        overflow: clip;
        background-color: var(--color-brand-grey-dark);
    }

    .ground {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 25.45%;
        background-color: var(--color-brand-grey-extra-dark);
    }

    .frame {
        position: relative;
        padding: 10px;
        border-radius: 16px;
        background: var(--color-brand-black);

        @media (--bp-600) {
            padding: 12px;
            border-radius: 20px;
        }

        @media (--bp-800) {
            padding: 16px;
            border-radius: 20px;
        }
    }

    .buttons-wrapper {
        position: absolute;
        top: 20%;
        left: -2px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 4px;
        height: 80px;
        justify-content: center;

        @media (--bp-600) {
            height: 108px;
        }
    }

    .device-button {
        width: 4px;
        height: calc(50% - 2px);
        border-radius: 2px;
        background-color: var(--color-brand-black);
    }

    .power-button-wrapper {
        left: auto;
        right: -2px;
    }

    .power-button {
        height: calc(70%);
    }
</style>

<figure class="tablet-image">
    <div class="ground"></div>
    <div class="frame">
        <slot />
    </div>
    {!!caption && <ImageCaption>{caption}</ImageCaption>}
</figure>
