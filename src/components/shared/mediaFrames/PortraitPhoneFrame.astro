---
import ImageCaption from '../ImageCaption.astro';

interface Props {
    caption?: string;
}

const { caption } = Astro.props;
---

<style>
    .phone-image {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 24px 22px;
        border-radius: 8px;
        overflow: clip;
        background-color: var(--color-brand-grey-dark);
    }

    .ground {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 25.45%;
        background-color: var(--color-brand-grey-extra-dark);
    }

    .frame {
        position: relative;
        max-width: 300px;
        padding: 6px;
        border-radius: 12px;
        background: var(--color-brand-black);

        @media (--bp-600) {
            padding: 8px;
        }

        @media (--bp-800) {
            padding: 12px;
            border-radius: 16px;
        }
    }

    .buttons-wrapper {
        position: absolute;
        top: 20%;
        left: -2px;
        display: flex;
        flex-direction: column;
        gap: 5%;
        width: 4px;
        height: 20%;
        justify-content: center;
    }

    .device-button {
        width: 4px;
        height: 45%;
        border-radius: 2px;
        background-color: var(--color-brand-black);
    }

    .power-button-wrapper {
        left: auto;
        right: -2px;
    }

    .power-button {
        height: calc(70%);
    }
</style>

<figure class="phone-image">
    <div class="ground"></div>
    <div class="frame">
        <div class="buttons-wrapper">
            <div class="device-button"></div>
            <div class="device-button"></div>
        </div>
        <div class="buttons-wrapper power-button-wrapper">
            <div class="device-button power-button"></div>
        </div>
        <slot />
    </div>
    {!!caption && <ImageCaption>{caption}</ImageCaption>}
</figure>
