---
import { Font } from 'astro:assets';

import {
    HEADER_HEIGHT,
    HEADER_OFFSET,
    HEADER_OFFSET_SMALL,
    HEADER_HEIGHT_SMALL,
    DEFAULT_SITE_DESCRIPTION,
} from '@snowbeat/constants';

import SiteHeader from '@snowbeat/components/global/SiteHeader.astro';
import SiteFooter from '@snowbeat/components/global/SiteFooter.astro';

interface Props {
    title?: string;
    description?: string;
}

const { title = 'Snowbeat', description = DEFAULT_SITE_DESCRIPTION } =
    Astro.props;
const siteUrl = Astro.site ?? new URL('https://snowbeat.uk');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL('/og-image.png', siteUrl);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Snowbeat" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />

        <Font cssVariable="--font-geist" />
        <Font cssVariable="--font-worksans" />
        <title>{title}</title>
    </head>
    <body>
        <style
            is:global
            define:vars={{
                'header-height': `${HEADER_HEIGHT}px`,
                'header-height-small': `${HEADER_HEIGHT_SMALL}px`,
                'header-offset': `${HEADER_OFFSET}px`,
                'header-offset-small': `${HEADER_OFFSET_SMALL}px`,
            }}
        >
            :root {
                --color-brand-yellow: #efff12;
                --color-brand-yellow-dark: #e4f400;
                --color-brand-yellow-extra-dark: #deee00;
                --color-brand-grey-light: #f9f9f9;
                --color-brand-grey-dark: #e0e0e0;
                --color-brand-grey-extra-dark: #d1d1d1;
                --color-brand-black: #191919;
                --color-brand-black-light: #505050;
                --color-brand-black-overlay: rgb(25 25 25 / 20%);
                --color-brand-white: #f3f3f3;
                --color-brand-grey-mid: #eee;
                --font-size-700: 2.5rem;
                --font-size-600: 2rem;
                --font-size-500: 1.5rem;
                --font-size-450: 1.25rem;
                --font-size-400: 1rem;
                --font-size-350: 0.875rem;
                --z-base: 1; /* Background layers */
                --z-above-base: 2; /* Sits on top of background layers */
                --z-controls: 10; /* Slideshow & video controls */
                --z-overlay: 99; /* Full-screen overlay/dimmer */
                --z-header: 100; /* Fixed header */
                --anim-main-nav-delay: 0.05s;
                --anim-easing-quad-inout: cubic-bezier(0.5, 1, 0.89, 1);

                @media (--bp-800) {
                    --font-size-700: 3.5rem;
                    --font-size-600: 2.5rem;
                    --font-size-500: 2rem;
                    --font-size-450: 1.5rem;
                    --font-size-400: 1.25rem;
                    --font-size-350: 1.125rem;
                }
            }

            ::selection {
                background-color: var(--color-brand-yellow-dark);
            }

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            * {
                margin: 0;
                padding: 0;
                font: inherit;
            }

            img,
            picture,
            svg,
            video {
                display: block;
            }

            html {
                scroll-behavior: smooth;
                scroll-padding-top: calc(
                    var(--header-height-small) + var(--header-offset-small) * 2
                );

                @media (prefers-reduced-motion: reduce) {
                    scroll-behavior: auto;
                }

                @media (--bp-800) {
                    scroll-padding-top: calc(
                        var(--header-height) + var(--header-offset) * 2
                    );
                }
            }

            html,
            body {
                min-height: 100svh;
                color: var(--color-brand-black);
                font-family: var(--font-worksans);
                letter-spacing: -2%;
                background-color: var(--color-brand-grey-light);
            }

            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                font-family: var(--font-geist);
                font-weight: 700;
            }

            p {
                font-size: var(--font-size-400);
                line-height: 28px;

                & > a {
                    font-weight: 600;
                    padding-inline: 4px;
                    padding-block: 4px;
                    color: inherit;
                    text-decoration: underline;
                    transition: background-color 0.15s linear;
                    background-color: var(--color-brand-yellow);

                    &:hover {
                        background-color: var(--color-brand-yellow-dark);
                    }
                }

                @media (--bp-800) {
                    line-height: 34px;
                }
            }

            .visually-hidden {
                position: absolute;
                opacity: 0;
                width: 1px;
                height: 1px;
                clip-path: inset(50%);
                white-space: nowrap;
                border: 0;
                overflow: hidden;
            }

            .section-content {
                max-width: 1180px;
                margin: 0 auto;
                padding-inline: 20px;

                @media (--bp-600) {
                    padding-inline: 30px;
                }

                @media (--bp-800) {
                    padding-inline: 50px;
                }
            }

            .section-content-reduced {
                max-width: 640px;
                margin: 0 auto;
                padding: 0 20px;

                @media (--bp-600) {
                    padding-inline: 30px;
                }

                @media (--bp-800) {
                    max-width: 840px;
                    padding-inline: 50px;
                }
            }
        </style>
        {Astro.url.pathname !== '/' && <SiteHeader />}
        <main>
            <slot />
        </main>
        <SiteFooter />
        <!-- Cloudflare Web Analytics -->
        <script
            is:inline
            type="module"
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon='{"token": "77bb4a247598433f964123926a5d110f"}'
        ></script><!-- End Cloudflare Web Analytics -->
    </body>
</html>
