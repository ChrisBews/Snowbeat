---
import { getCollection, render } from 'astro:content';

import SiteLayout from '@snowbeat/layouts/SiteLayout.astro';
import PrimaryImage from '@snowbeat/components/projects/PrimaryImage.astro';
import ProjectMeta from '@snowbeat/components/projects/ProjectMeta.astro';

// Generates a new path for every collection item
export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<style>
    main {
        background-color: var(--color-brand-grey-light);
    }

    .project-content {
        display: flex;
        flex-direction: column;
        gap: 32px;
        padding-bottom: 40px;
    }
</style>

<SiteLayout title="Projects · Snowbeat">
    <PrimaryImage
        image={project.data.primaryImage}
        alt={`${project.data.title} logo`}
    />
    <ProjectMeta
        title={project.data.title}
        type={project.data.type}
        startDate={project.data.startDate}
        endDate={project.data.endDate}
        technologies={project.data.technologies}
        languages={project.data.languages}
    />
    <div class="project-content">
        <Content />
    </div>
</SiteLayout>
