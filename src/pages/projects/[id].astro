---
import { getCollection, render } from 'astro:content';

import SiteLayout from '@snowbeat/layouts/SiteLayout.astro';
import PrimaryImage from '@snowbeat/components/projects/PrimaryImage.astro';
import SecondaryImage from '@snowbeat/components/projects/SecondayImage.astro';
import ProjectMeta from '@snowbeat/components/projects/ProjectMeta.astro';
import ProjectDescription from '@snowbeat/components/projects/ProjectDescription.astro';

// Generates a new path for every collection item
export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<style>
    main {
        background-color: var(--color-brand-grey-light);
    }
</style>

<SiteLayout>
    <main>
        <PrimaryImage
            image={project.data.primaryImage}
            alt={`${project.data.title} logo`}
        />
        <ProjectMeta
            title={project.data.title}
            type={project.data.type}
            startDate={project.data.startDate}
            endDate={project.data.endDate}
            technologies={project.data.technologies}
            languages={project.data.languages}
        />
        {
            !!project.data.secondaryImage && (
                <SecondaryImage
                    image={project.data.secondaryImage}
                    type={project.data.secondaryImageType}
                />
            )
        }
        <ProjectDescription
            websiteUrl={project.data.websiteUrl}
            appStoreUrl={project.data.appStoreUrl}
            playStoreUrl={project.data.playStoreUrl}
            ><Content /></ProjectDescription
        >
    </main>
</SiteLayout>
