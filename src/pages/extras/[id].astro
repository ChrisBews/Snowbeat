---
import { getCollection, render } from 'astro:content';

import SiteLayout from '@snowbeat/layouts/SiteLayout.astro';
import { Image } from 'astro:assets';

// Generates a new path for every collection item
export async function getStaticPaths() {
    const extraProjects = await getCollection('extras');

    return extraProjects.map((extraProject) => ({
        params: { id: extraProject.id },
        props: { extraProject },
    }));
}

const { extraProject } = Astro.props;
const { Content } = await render(extraProject);
---

<SiteLayout>
    <Image
        src={extraProject.data.primaryImage}
        alt={`${extraProject.data.title} logo`}
        layout="full-width"
    />
    <Content />
</SiteLayout>
